<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest
    ExtensionBundleId="com.suai.pngexport"
    ExtensionBundleVersion="3.7.2"
    Version="9.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <ExtensionList>
        <Extension Id="com.suai.pngexport.panel" Version="3.7.2" />
    </ExtensionList>

    <ExecutionEnvironment>
        <HostList>
            <Host Name="ILST" Version="[24.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>

    <DispatchInfoList>
        <Extension Id="com.suai.pngexport.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/main.jsx</ScriptPath>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>SU+AI PNG 导出</Menu>
                    <Geometry>
                        <Size>
                            <Height>350</Height>
                            <Width>360</Width>
                        </Size>
                        <MinSize>
                            <Height>320</Height>
                            <Width>300</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>900</Height>
                            <Width>800</Width>
                        </MaxSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./client/icons/icon-normal.png</Icon>
                        <Icon Type="RollOver">./client/icons/icon-hover.png</Icon>
                        <Icon Type="Disabled">./client/icons/icon-disabled.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
